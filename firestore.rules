rules_version = '2';
// Bu kuralları Firebase konsolu > Firestore Database > Kurallar (Rules) sekmesine yapıştır.
// SENIN_EPOSTAN@gmail.com yerine giriş yapacağın Google hesabını yaz.
// Sadece o hesap okuyup yazabilir; fiyat güncelleyici (GitHub Actions) servis
// hesabıyla çalıştığı için bu kurallardan etkilenmez.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'SENIN_EPOSTAN@gmail.com';
    }
  }
}
